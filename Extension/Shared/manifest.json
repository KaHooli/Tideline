{
  "manifest_version": 3,
  "name": "Tideline",
  "version": "1.0",
  "description": "Manage, sort, and clean up your Safari bookmarks.",
  "permissions": ["bookmarks", "nativeMessaging", "storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "19": "images/toolbar-19.png",
      "20": "images/toolbar-20.png",
      "32": "images/toolbar-32.png",
      "38": "images/toolbar-38.png",
      "40": "images/toolbar-40.png",
      "48": "images/toolbar-48.png",
      "64": "images/toolbar-64.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  }
}
